# Скопируйте в .env и заполните локально. Не публикуйте настоящий .env.
TELEGRAM_BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_ИЗ_BOTFATHER
# OpenAI-совместимый API; для локального Ollama: http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=название-модели
# Для локального Ollama можно оставить пустым.
LLM_API_KEY=
CHARACTER_PROMPT=Ты вымышленный персонаж, общительный и любопытный. Пиши естественно, на русском языке.
DATABASE_PATH=data/tgbot.sqlite3
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
